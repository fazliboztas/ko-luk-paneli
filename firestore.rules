rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function user() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCoach() {
      return signedIn() && user().role == 'coach';
    }

    function ownsStudent(studentId) {
      return signedIn() && user().role == 'student' && user().studentId == studentId;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isCoach());
      allow create, update, delete: if isCoach();
    }

    match /students/{studentId} {
      allow read: if isCoach() || ownsStudent(studentId);
      allow create, update, delete: if isCoach();
    }

    match /tasks/{taskId} {
      allow read: if isCoach() || ownsStudent(resource.data.studentId);
      allow create: if isCoach();
      allow update: if isCoach() || (ownsStudent(resource.data.studentId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['completed', 'result', 'solvedQuestions']));
      allow delete: if isCoach();
    }
  }
}
